root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.lua]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
# В markdown два пробела на конце строки — значимый перенос.
trim_trailing_whitespace = false
max_line_length = 80

# changelog.txt Factorio: парсер запрещает табы и пробелы в конце строк,
# отступы значимы (2 пробела — категория, 4 — запись, 6 — продолжение).
[changelog.txt]
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true
