{
  "name": "factorio-modding",
  "version": "0.1.0",
  "private": true,
  "description": "Монорепозиторий модов Factorio автора Shahimat",
  "author": "Shahimat",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "mods/*"
  ],
  "scripts": {
    "session": "claude \"/startup\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tools/**/*.test.ts\"",
    "test:mod": "node tools/lua-test.ts",
    "test:lua:all": "node tools/lua-test.ts --all",
    "test:ingame": "node tools/ingame-test.ts",
    "check-docs": "node tools/check-docs.ts",
    "check-lua": "node tools/check-lua.ts",
    "check-secrets": "node tools/check-secrets.ts",
    "validate": "node tools/validate.ts",
    "pack": "node tools/pack.ts",
    "recolor-sprites": "node tools/recolor-sprites.ts",
    "check": "npm run typecheck && npm test && npm run check-secrets && npm run check-docs && npm run validate",
    "check:mod": "node tools/check-mod.ts",
    "publish:mod": "node tools/publish.ts",
    "orbital-art": "node tools/orbital-art.ts"
  },
  "devDependencies": {
    "@shahimat/ai-core": "^0.1.6",
    "@shahimat/oc3": "^0.1.3",
    "@types/node": "^24.9.2",
    "@types/pngjs": "^6.0.5",
    "factorio-test-cli": "^3.6.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
