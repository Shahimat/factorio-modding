# Шаблон локальных секретов. Скопируй в .env.local и подставь значения.
#
#   cp .env.example .env.local
#   # впиши значение
#   source .env.local
#
# .env.local игнорируется git. Этот файл — версионируется и значений
# не содержит. Жёсткое правило — context/conventions/secrets.yml.

# API-ключ мод-портала. Один ключ с тремя usage:
#   ModPortal: Publish Mods / Upload Mods / Edit Mods
# Выпускается на https://factorio.com/profile, показывается один раз.
# Имя переменной задано CLI fmtk и имеет приоритет над Keychain.
# Как выпустить и проверить — docs/manuals/setup-dev-environment.md, шаги 6-7.
export FACTORIO_UPLOAD_API_KEY=
